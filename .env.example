NEXT_PUBLIC_CHAINED_SUMMARY_TEXT_MAX_GRAPHEMES=2000
NEXT_PUBLIC_HEADING_MAX_GRAPHEMES=160
NEXT_PUBLIC_GEMINI_LIVE_SESSION_MAX_SECONDS=540
NEXT_PUBLIC_GEMINI_PENDING_PCM_CHUNKS=128

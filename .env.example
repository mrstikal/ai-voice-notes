READ_TOOL_SECTION_MAX_GRAPHEMES=1200

# --- Server rate limits (count per window) ------------------------------------
# Each accepts a companion <NAME>_WINDOW_MS; the default window is 60000 ms.
# ASK_RATE_LIMIT defaults to 1000 under NODE_ENV=test and 6 otherwise.
SEARCH_SEMANTIC_RATE_LIMIT=10
DEFAULT_REINDEX_RATE_LIMIT=6
DEFAULT_READ_ALOUD_RATE_LIMIT=30
ASK_RATE_LIMIT=6
MEETING_INSPECT_RATE_LIMIT=10
MEETING_SAVE_RATE_LIMIT=5
DEFAULT_MEETING_TRANSCRIBE_RATE_LIMIT=3
DEFAULT_TTS_RATE_LIMIT=5
DEFAULT_SCRIBE_TOKEN_RATE_LIMIT=5
GEMINI_TOKEN_RATE_LIMIT=5
VOICE_AGENT_TOOL_RATE_LIMIT=60
VOICE_AGENT_PENDING_RATE_LIMIT=60
VOICE_AGENT_CONFIRM_RATE_LIMIT=30
VOICE_AGENT_CHAINED_RATE_LIMIT=30

# --- Client-visible limits (NEXT_PUBLIC_) -------------------------------------
# Next.js inlines NEXT_PUBLIC_ values into browser bundles at BUILD time. Change
# them only before `pnpm build`/`pnpm dev`; a running browser will not pick up a
# new value. These are non-secret numeric bounds used by editor/voice UI.
NEXT_PUBLIC_TITLE_MAX_GRAPHEMES=160
NEXT_PUBLIC_OPERATION_TEXT_MAX_GRAPHEMES=2000
NEXT_PUBLIC_OPERATION_HEADING_MAX_GRAPHEMES=160
NEXT_PUBLIC_OPERATION_TASK_MAX_GRAPHEMES=200
NEXT_PUBLIC_NOTE_TAGS_MAX=20
NEXT_PUBLIC_NOTE_TAG_MAX_GRAPHEMES=32
NEXT_PUBLIC_READ_SELECTION_MAX_PARAGRAPHS=5
NEXT_PUBLIC_READ_SELECTION_TRANSCRIPT_MAX_GRAPHEMES=500
NEXT_PUBLIC_DRAFT_AUTOSAVE_DEBOUNCE_MS=800
NEXT_PUBLIC_SUMMARY_MAX_SOURCE_GRAPHEMES=8000
NEXT_PUBLIC_SUMMARY_MAX_GRAPHEMES=2000
NEXT_PUBLIC_SUMMARY_MAX_TTS_CODE_UNITS=3500
NEXT_PUBLIC_TASK_SUGGESTION_MAX_TASKS=10
NEXT_PUBLIC_TASK_SUGGESTION_MAX_TEXT_GRAPHEMES=160
NEXT_PUBLIC_TASK_SUGGESTION_MAX_SOURCE_GRAPHEMES=4000
NEXT_PUBLIC_TASK_SUGGESTION_TTL_MS=300000

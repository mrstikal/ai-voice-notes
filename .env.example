FFPROBE_PACKET_MAX_OUTPUT_BYTES=4194304
SCRIBE_BATCH_TIMEOUT_MS=240000
SCRIBE_BATCH_MAX_WORDS=300000
SCRIBE_BATCH_MAX_RESPONSE_BYTES=8388608
MEETING_TRANSCRIPT_MAX_GRAPHEMES=60000

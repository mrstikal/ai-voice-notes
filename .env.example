ASK_QUESTION_MAX_CODE_UNITS=3000
GROUNDING_MAX_SOURCES=6
GROUNDING_SOURCE_MAX_GRAPHEMES=700
GROUNDING_SOURCE_MAX_CODE_UNITS=900
GROUNDING_MAX_CLAIMS=6
GROUNDING_CLAIM_MAX_GRAPHEMES=400
GROUNDING_CLAIM_MAX_CITATIONS=3
GROUNDING_MAX_OUTPUT_TOKENS=4000

# --- TTS, HTTP payload and temp/export caps -----------------------------------
TTS_MAX_INPUT_CODE_UNITS=3500
TTS_MAX_AUDIO_BYTES=8388608
TTS_TIMEOUT_MS=60000

# Copy this file to .env.local and adjust local values if needed.
# Never commit .env.local, .env.test.local, or real provider keys.

# Docker Compose host port mappings. Compose reads these from .env (not
# .env.local); the defaults are used when no .env file exists. Override them in
# a local .env file only when the host ports are already occupied.
DB_HOST_PORT=5432
TEST_DB_HOST_PORT=5433

# The app binds to this loopback origin. Only 127.0.0.1, localhost, or ::1
# with an explicit port are accepted.
APP_ORIGIN=http://127.0.0.1:3000

# Set to 1 only if a local IDE/remote port forwarder sends a different
# loopback port in Host (for example VS Code forwarding 3000 to 53508).
# The Host and Origin must still be loopback and use the same port.
APP_ALLOW_FORWARDED_LOOPBACK=0

# Local development database from compose.yaml.
DATABASE_URL=postgresql://ai_voice_notes:ai_voice_notes@127.0.0.1:5432/ai_voice_notes

# Isolated test database (compose profile "test", port 5433).
# For test-scoped CLI commands, copy DATABASE_URL and TEST_DATABASE_URL into a
# gitignored .env.test.local; the two targets must be distinct.
TEST_DATABASE_URL=postgresql://ai_voice_notes:ai_voice_notes@127.0.0.1:5433/ai_voice_notes_test

# Test-only switch. Leave empty during normal local use. When set to 1, the
# running app requires DATABASE_URL (and, when set, TEST_DATABASE_URL) to name
# a database ending with _test, loopback ELEVENLABS_API_BASE_URL and
# GEMINI_API_BASE_URL mocks with an explicit port, and exact dummy provider
# keys (test-only-elevenlabs, test-only-openrouter, test-only-gemini) for every
# configured key. Real keys are rejected before a provider client is
# constructed.
AI_TEST_MODE=

# Provider keys are optional. Leave them empty until a phase that needs them
# and a separately authorized live check. The typed-notes app works without them.
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
OPENROUTER_API_KEY=
# P21 freezes this preflighted candidate. Changing it requires a new
# capability/account preflight and explicit user approval; unsupported models
# block the structured AI path rather than falling back to free text.
OPENROUTER_LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# P18 pins elevenlabs/eleven-v4-turbo in code. This value is reserved for a
# future validated model choice and does not override the pinned model.
OPENROUTER_TTS_MODEL=
# P36 pins this model and the 1536-dimensional vector column. A different value
# blocks semantic indexing with a Czech reason; changing it needs a new
# migration/reindex decision, not a silent switch.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# P55 replaces the retired OpenAI voice path with Gemini Live. A different
# non-empty GEMINI_LIVE_MODEL blocks the voice agent with a Czech explanation;
# it never silently switches model. The long-lived key stays on the server.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Test-only override for the E2E Gemini token mock. Leave empty/unset for a
# real provider; in AI_TEST_MODE it must be http on loopback with a port.
GEMINI_API_BASE_URL=

# Application limits. AI_REQUEST_BUDGET_USD is an app-side estimated admission
# budget, not a provider spending cap. Changing it never clears the database
# usage ledger; reset that explicitly in Settings when no operation is active.
# NOTE_MAX_CHARACTERS may not exceed the frozen 20,000-grapheme safety ceiling.
NOTE_MAX_CHARACTERS=20000
MEETING_MAX_MINUTES=15
AI_REQUEST_BUDGET_USD=2.00

# Operational limits. Every value below has the same default as the previous
# hardcoded constant, so leaving a variable unset keeps current behavior. The
# values are validated at startup/module load: positive safe integers (or
# non-negative decimals for money) are required and an invalid value fails fast.
# Frozen contracts are NOT configurable here: provider/model IDs, per-token or
# per-hour prices, embedding dimensions (1536), PCM sample rates (16/24 kHz),
# chunk token bounds (cl100k 300-800), the 20,000-grapheme note ceiling and the
# 4/20/20 voice-tool caps remain pinned in code. Do not raise a bound to work
# around a provider error.

# --- AI / LLM -----------------------------------------------------------------
LLM_INPUT_MAX_CODE_UNITS=12000
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_MS=20000
LLM_RESPONSE_MAX_BYTES=65536
LLM_PROMPT_OVERHEAD_TOKENS=256
LLM_MAX_ESTIMATED_COST_USD=0.02
OPENROUTER_DEFAULT_TIMEOUT_MS=60000
OPENROUTER_ERROR_BODY_MAX_BYTES=65536
CLEANUP_PARAGRAPH_MAX_GRAPHEMES=2000
CLEANUP_PROPER_NAMES_MAX=20
CLEANUP_PROPER_NAME_MAX_GRAPHEMES=80
CLEANUP_TARGET_PHRASE_MAX_GRAPHEMES=160
TASK_SUGGESTION_MAX_PROMPT_CODE_UNITS=12000
TASK_SECTION_MAX_GRAPHEMES=2000
TAG_SUGGESTION_MAX_TAGS=5
TAG_SUGGESTION_MAX_SOURCE_GRAPHEMES=8000
TAG_SUGGESTION_MAX_PROMPT_CODE_UNITS=12000
TAG_SUGGESTION_TTL_MS=300000
SUMMARY_OPERATION_LIMIT=50
MAX_PROVIDER_USAGE_BYTES=16384
PROPOSAL_EXPIRY_MS=300000
PROPOSAL_TEXT_MAX_BYTES=32768
DOCX_EXPORT_MAX_BYTES=8388608

